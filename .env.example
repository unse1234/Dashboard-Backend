# Copy to .env and fill in. Never commit real values.

# --- App ---
NODE_ENV=development            # development | test | production
PORT=3001
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dashboard_db?schema=public"

# Exact origins (scheme://host[:port], no trailing slash) allowed for CORS and CSRF checks.
CORS_ORIGINS=http://localhost:3000
# Dashboard base URL; used to build links in emails.
FRONTEND_URL=http://localhost:3000
# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY=0

# --- Tokens ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=ecom-dash-api
JWT_AUDIENCE=ecom-dash-dashboard
REFRESH_TOKEN_TTL_DAYS=7

# Request throttling on auth endpoints. Only disable in automated tests; required in production.
RATE_LIMIT_ENABLED=true

# --- Refresh cookie ---
COOKIE_SECURE=false             # must be true in production
COOKIE_SAMESITE=strict          # strict | lax | none (none requires COOKIE_SECURE=true)
COOKIE_DOMAIN=                  # optional

# --- Link lifetimes ---
PASSWORD_RESET_TTL_MINUTES=30
INVITATION_TTL_HOURS=72
EMAIL_VERIFICATION_TTL_HOURS=24

# --- Mail ---
MAIL_TRANSPORT=console          # console (development only) | smtp (required in production)
MAIL_FROM="Ecom Dash <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false               # true for implicit TLS (usually port 465)
SMTP_USER=
SMTP_PASS=

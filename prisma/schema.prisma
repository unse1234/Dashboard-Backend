generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum SessionRevokeReason {
  LOGOUT
  USER_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  REUSE_DETECTED
  ACCOUNT_DISABLED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  // Null until an invited user sets a password; login treats null as invalid credentials.
  passwordHash    String?
  role            Role      @default(STAFF)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  // Soft delete. Accounts are never hard-deleted so that records referencing a user
  // (orders, audit trails, ...) stay intact. A deleted user is always inactive, which
  // a CHECK constraint in the migration enforces; that is what blocks sign-in.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  productEvents           ProductEvent[]
  orderEvents             OrderEvent[]
  importJobs              ImportJob[]
}

enum ImportType {
  PRODUCTS
}

enum ImportJobStatus {
  READY
  VALIDATION_FAILED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model ImportJob {
  id                    String          @id @default(uuid())
  number                Int             @unique @default(autoincrement())
  type                  ImportType      @default(PRODUCTS)
  status                ImportJobStatus
  initiatedById         String
  initiatedBy           User            @relation(fields: [initiatedById], references: [id], onDelete: Restrict)
  originalFilename      String
  fileSizeBytes         Int
  fileSha256            String
  clientRequestId       String
  requestHash           String
  schemaVersion         Int             @default(1)
  previewHash           String
  totalRows             Int
  validRows             Int
  invalidRows           Int
  importedRows          Int             @default(0)
  createdProductNumbers Json?
  previewPayload        Json?
  errors                Json?
  failureCode           String?
  failureMessage        String?
  retryable             Boolean         @default(false)
  attemptToken          String?
  attemptExpiresAt      DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  startedAt             DateTime?
  completedAt           DateTime?
  previewExpiresAt      DateTime
  errorsExpiresAt       DateTime
  retainUntil           DateTime

  @@unique([initiatedById, clientRequestId])
  @@index([initiatedById, createdAt(sort: Desc), number(sort: Desc)])
  @@index([status, createdAt(sort: Desc), number(sort: Desc)])
  @@index([createdAt(sort: Desc), number(sort: Desc)])
  @@index([previewExpiresAt])
  @@index([errorsExpiresAt])
  @@index([retainUntil])
  @@index([status, attemptExpiresAt])
}

// One row per signed-in browser. The refresh credential is "<id>.<secret>"; only
// the SHA-256 of the secret is stored.
model Session {
  id                       String               @id @default(uuid())
  userId                   String
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash         String
  // Hash replaced by the latest rotation; lets a lost race be told apart from token theft.
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  expiresAt                DateTime
  lastUsedAt               DateTime             @default(now())
  revokedAt                DateTime?
  revokedReason            SessionRevokeReason?
  ipAddress                String?
  userAgent                String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Also used for staff invitations: accepting an invite is a password reset that
// additionally verifies the email address.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers and orders. Customers are storefront shoppers, a separate identity
// from dashboard users: they never sign in here and have no relation to User.
// ---------------------------------------------------------------------------

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Informational only: the dashboard does not take, capture or refund payments.
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Customer {
  // Internal key; never exposed. The public id is "CUS-<number>".
  id        String   @id @default(uuid())
  number    Int      @unique @default(autoincrement())
  name      String
  // Stored lower-cased, like User.email.
  email     String   @unique
  // As the customer typed it.
  phone     String?
  // Exposed as joinedAt.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@index([createdAt])
}

// At most one default address per customer and type; a partial unique index in
// the migration enforces it.
model CustomerAddress {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          AddressType
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  region        String?
  postalCode    String?
  country       String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId, type])
}

// An order keeps snapshots of the customer, addresses and products as they were
// when it was placed, so it reads the same if any of them later change. Only its
// status and payment status ever change afterwards. The migrations check that
// amounts are never negative, that total = subtotal + shipping - discount + tax,
// and that the status and payment status make sense together (an order that was
// shipped is paid; a cancelled one is never "paid").
model Order {
  // Internal key; never exposed. The public id is "ORD-<number>".
  id              String        @id @default(uuid())
  number          Int           @unique @default(autoincrement())
  customerId      String
  // Restrict: orders are business records, so a customer with orders is never hard-deleted.
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName    String
  customerEmail   String
  customerPhone   String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(12, 2)
  shipping        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  // OrderAddress snapshots (recipientName, phone, addressLine1, addressLine2,
  // city, region, postalCode, country).
  shippingAddress Json
  billingAddress  Json
  // Units across all lines. Written once, with the lines, so the list can show
  // and sort by it without loading them.
  itemCount       Int           @default(0)
  // The Idempotency-Key of the request that created the order, and a hash of that
  // request: a retry with the same key and body returns this order instead of
  // placing a second one. Null for orders that were not created through the API.
  idempotencyKey  String?       @unique
  requestHash     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items  OrderItem[]
  events OrderEvent[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@index([status, createdAt(sort: Desc)])
}

enum OrderEventType {
  CREATED
  STATUS_CHANGED
  PAYMENT_STATUS_CHANGED
}

// Who changed an order, from what and to what. Written in the same transaction
// as the change; the dashboard does not show it yet.
model OrderEvent {
  id                String         @id @default(uuid())
  orderId           String
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type              OrderEventType
  fromStatus        OrderStatus?
  toStatus          OrderStatus?
  fromPaymentStatus PaymentStatus?
  toPaymentStatus   PaymentStatus?
  // Null for a change that no signed-in person made.
  actorId           String?
  actor             User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt         DateTime       @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The product's public id ("PRD-<number>") as a snapshot, so the line reads the
  // same whatever later happens to the product.
  productId        String
  productName      String
  sku              String
  quantity         Int
  unitPrice        Decimal  @db.Decimal(12, 2)
  // quantity x unitPrice, checked in the migration.
  total            Decimal  @db.Decimal(12, 2)
  // Where the line sits in the order, so that it always lists in the order it was
  // placed in.
  position         Int      @default(0)
  // The catalogue product the line came from. Null for lines recorded before
  // products existed. Restrict: products are archived, never deleted.
  catalogProductId String?
  product          Product? @relation(fields: [catalogProductId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([catalogProductId])
}

// ---------------------------------------------------------------------------
// Products. One product is one sellable unit: one SKU, one price, one stock
// count. Order lines snapshot the product, so editing or archiving it never
// rewrites history.
// ---------------------------------------------------------------------------

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ProductEventType {
  CREATED
  DETAILS_UPDATED
  PRICE_CHANGED
  STATUS_CHANGED
  STOCK_CHANGED
  ARCHIVED
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

// Constraints in the migration that Prisma does not model: the SKU is unique
// case-insensitively (archived rows included, so a SKU is never reused), prices
// are not negative, and stock is never below zero, which is what makes overselling
// impossible even if application code is wrong.
model Product {
  // Internal key; never exposed. The public id is "PRD-<number>".
  id          String        @id @default(uuid())
  number      Int           @unique @default(autoincrement())
  name        String
  sku         String
  description String?
  brand       String?
  categoryId  String
  // Restrict: a category that still has products cannot be removed.
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status      ProductStatus @default(ACTIVE)
  price       Decimal       @db.Decimal(12, 2)
  costPrice   Decimal?      @db.Decimal(12, 2)
  stock       Int           @default(0)
  // Optimistic concurrency: every write increments it, order-driven stock changes
  // included, so a stale form can never overwrite a newer stock level.
  version     Int           @default(1)
  // Soft delete. An archived product is hidden from every products endpoint.
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  events     ProductEvent[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([createdAt])
}

// The edit history shown on the product page. One row per change, written in the
// same transaction as the change itself.
model ProductEvent {
  id        String           @id @default(uuid())
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type      ProductEventType
  // Shape depends on the type; see src/products/product-events.ts.
  data      Json
  // Null for automatic changes (an order placed or cancelled); shown as "System".
  actorId   String?
  actor     User?            @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())

  @@index([productId, createdAt(sort: Desc)])
}

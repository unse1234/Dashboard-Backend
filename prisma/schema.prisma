generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum SessionRevokeReason {
  LOGOUT
  USER_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
  REUSE_DETECTED
  ACCOUNT_DISABLED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String    @unique
  // Null until an invited user sets a password; login treats null as invalid credentials.
  passwordHash    String?
  role            Role      @default(STAFF)
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  // Soft delete. Accounts are never hard-deleted so that records referencing a user
  // (orders, audit trails, ...) stay intact. A deleted user is always inactive, which
  // a CHECK constraint in the migration enforces; that is what blocks sign-in.
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
}

// One row per signed-in browser. The refresh credential is "<id>.<secret>"; only
// the SHA-256 of the secret is stored.
model Session {
  id                       String               @id @default(uuid())
  userId                   String
  user                     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash         String
  // Hash replaced by the latest rotation; lets a lost race be told apart from token theft.
  previousRefreshTokenHash String?
  rotatedAt                DateTime?
  expiresAt                DateTime
  lastUsedAt               DateTime             @default(now())
  revokedAt                DateTime?
  revokedReason            SessionRevokeReason?
  ipAddress                String?
  userAgent                String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// Also used for staff invitations: accepting an invite is a password reset that
// additionally verifies the email address.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Customers and orders. Customers are storefront shoppers, a separate identity
// from dashboard users: they never sign in here and have no relation to User.
// ---------------------------------------------------------------------------

enum AddressType {
  SHIPPING
  BILLING
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

// Informational only: the dashboard does not take, capture or refund payments.
enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

model Customer {
  // Internal key; never exposed. The public id is "CUS-<number>".
  id        String   @id @default(uuid())
  number    Int      @unique @default(autoincrement())
  name      String
  // Stored lower-cased, like User.email.
  email     String   @unique
  // As the customer typed it.
  phone     String?
  // Exposed as joinedAt.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@index([createdAt])
}

// At most one default address per customer and type; a partial unique index in
// the migration enforces it.
model CustomerAddress {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type          AddressType
  recipientName String
  phone         String?
  addressLine1  String
  addressLine2  String?
  city          String
  region        String?
  postalCode    String?
  country       String
  isDefault     Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId, type])
}

// An order keeps snapshots of the customer, addresses and products as they were
// when it was placed, so it reads the same if any of them later change. Amounts
// are checked in the migration: none negative, and total = subtotal + shipping
// - discount + tax.
model Order {
  // Internal key; never exposed. The public id is "ORD-<number>".
  id              String        @id @default(uuid())
  number          Int           @unique @default(autoincrement())
  customerId      String
  // Restrict: orders are business records, so a customer with orders is never hard-deleted.
  customer        Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  customerName    String
  customerEmail   String
  customerPhone   String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(12, 2)
  shipping        Decimal       @db.Decimal(12, 2)
  discount        Decimal       @db.Decimal(12, 2)
  tax             Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  // OrderAddress snapshots (recipientName, phone, addressLine1, addressLine2,
  // city, region, postalCode, country).
  shippingAddress Json
  billingAddress  Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items OrderItem[]

  @@index([customerId, createdAt(sort: Desc)])
  @@index([createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // The product's public id as a snapshot. There is no Product table yet; the
  // Products module adds the foreign key.
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  // quantity x unitPrice, checked in the migration.
  total       Decimal @db.Decimal(12, 2)

  @@index([orderId])
}
